        <mxCell id="main-body" value="Constructs BoundedParserFacade, EffectChecker, JvmBackend and ClassFileWriter.&#xa;Injects them into BoundedCompiler through its four port interfaces.&#xa;Hands the CLI a CompileProgram; adapter selection happens only here." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#52657B;fontStyle=0;align=left;verticalAlign=middle;spacing=0;resizable=1;" parent="main" vertex="1" connectable="0">
